# ============================================================
# PROJO GROUP — Environment Variables Template
# Copy this to .env and fill in your real values
# ============================================================

# ─── APP ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
APP_NAME=PROJO GROUP

# ─── DATABASE ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/projogroup
DIRECT_URL=postgresql://postgres:password@localhost:5432/projogroup

# ─── JWT AUTH ───────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# ─── TWILIO (SMS OTP — South Africa) ────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+27xxxxxxxxx
OTP_EXPIRY_MINUTES=10

# ─── MAPS (Leaflet + OpenStreetMap — NO API KEY NEEDED!) ────
# Maps powered by Leaflet + OpenStreetMap — 100% free, no key
# Distance calculation via OSRM — 100% free, no key
RUSTENBURG_LAT=-25.6670
RUSTENBURG_LNG=27.2420
OSRM_BASE_URL=https://router.project-osrm.org

# ─── PAYFAST (ZAR Payments) ─────────────────────────────────
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
PAYFAST_SANDBOX=true
PAYFAST_URL=https://sandbox.payfast.co.za/eng/process

# ─── CLOUDINARY (File / Image Storage) ──────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── SOCKET.IO ──────────────────────────────────────────────
SOCKET_CORS_ORIGIN=http://localhost:3000

# ─── REDIS (optional — for caching) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ─── EMAIL (optional — nodemailer) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@projogroup.co.za
SMTP_PASS=your_email_password

# ─── PROJO GROUP PRICING (hardcoded, do not change) ─────────
FLAT_RATE_ZAR=60
PER_KM_RATE_ZAR=7.50
MIN_FARE_ZAR=60
SURGE_MULTIPLIER=1.15
DRIVER_COMMISSION_PCT=80
PROJO_COMMISSION_PCT=20

# ─── PROJO GROUP SOCIAL LINKS ───────────────────────────────
WHATSAPP_NUMBER=27766147986
SHOP_URL=https://take.app/projogroup
FACEBOOK_URL=https://www.facebook.com/projogroup247
INSTAGRAM_URL=https://www.instagram.com/projogroup?igsh=dGNsdTk3NmlvMjh2
WEBSITE_URL=https://www.projogroup.co.za
SUPPORT_EMAIL=info@projogroup.co.za
