// ============================================================
// PROJO GROUP — Prisma Database Schema
// PostgreSQL | All amounts in ZAR (South African Rand)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
}

enum DriverStatus {
  OFFLINE
  ONLINE
  ON_RIDE
  ON_DELIVERY
}

enum DriverApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VehicleType {
  ECONOMY
  COMFORT
  XL
  LUXURY
  BIKE
  VAN
  BUSINESS
}

enum RideStatus {
  REQUESTED
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE
  ARRIVED_AT_PICKUP
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FareZone {
  ZONE_1_FLAT    // Inside Rustenburg — R60 flat
  ZONE_2_PER_KM  // Outside Rustenburg — R7.50/km
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum TransactionType {
  TOPUP
  RIDE_PAYMENT
  DELIVERY_PAYMENT
  SHOP_PAYMENT
  REFERRAL_BONUS
  LOYALTY_POINTS
  DRIVER_PAYOUT
  REFUND
  PROMO_CREDIT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ─── USERS ───────────────────────────────────────────────────

model User {
  id              String      @id @default(uuid())
  email           String?     @unique
  phone           String      @unique  // SA format: +27xxxxxxxxx
  name            String
  role            UserRole    @default(PASSENGER)
  status          UserStatus  @default(PENDING_VERIFICATION)
  avatarUrl       String?
  referralCode    String      @unique @default(cuid())
  referredById    String?
  referredBy      User?       @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]      @relation("Referrals")
  
  // Auth
  passwordHash    String?
  otpCode         String?
  otpExpiresAt    DateTime?
  lastLoginAt     DateTime?
  fcmToken        String?     // Firebase push notifications
  
  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  // Relations
  driverProfile   Driver?
  wallet          Wallet?
  ridesAsPassenger  Ride[]    @relation("PassengerRides")
  ratingsGiven    Rating[]    @relation("RatingsGiven")
  ratingsReceived Rating[]    @relation("RatingsReceived")
  orders          Order[]
  notifications   Notification[]

  @@map("users")
}

// ─── DRIVERS ─────────────────────────────────────────────────

model Driver {
  id                    String               @id @default(uuid())
  userId                String               @unique
  user                  User                 @relation(fields: [userId], references: [id])
  
  // Personal docs
  idNumber              String?              // SA ID number
  idDocumentUrl         String?
  licenseNumber         String?
  licenseDocumentUrl    String?
  pdpNumber             String?              // Professional Driving Permit
  pdpDocumentUrl        String?
  
  // Status
  status                DriverStatus         @default(OFFLINE)
  approvalStatus        DriverApprovalStatus @default(PENDING)
  approvalNote          String?
  
  // Location (last known — updated via Socket.io)
  latitude              Float?
  longitude             Float?
  lastLocationUpdate    DateTime?
  
  // Stats
  totalRides            Int                  @default(0)
  totalEarnings         Float                @default(0)  // ZAR
  rating                Float                @default(0)
  ratingCount           Int                  @default(0)
  
  // Home zone
  homeZone              String               @default("Rustenburg")
  
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  
  // Relations
  vehicles              Vehicle[]
  rides                 Ride[]               @relation("DriverRides")
  deliveries            Delivery[]

  @@map("drivers")
}

// ─── VEHICLES ────────────────────────────────────────────────

model Vehicle {
  id              String      @id @default(uuid())
  driverId        String
  driver          Driver      @relation(fields: [driverId], references: [id])
  
  type            VehicleType
  make            String      // e.g. Toyota
  model           String      // e.g. Corolla
  year            Int
  color           String
  licensePlate    String      @unique
  
  // Multipliers applied to base fare
  // Economy: 1.0, Comfort: 1.3, XL: 1.5, Luxury: 2.5
  fareMultiplier  Float       @default(1.0)
  
  isActive        Boolean     @default(true)
  isVerified      Boolean     @default(false)
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  rides           Ride[]

  @@map("vehicles")
}

// ─── RIDES ───────────────────────────────────────────────────

model Ride {
  id                String     @id @default(uuid())
  
  // Parties
  passengerId       String
  passenger         User       @relation("PassengerRides", fields: [passengerId], references: [id])
  driverId          String?
  driver            Driver?    @relation("DriverRides", fields: [driverId], references: [id])
  vehicleId         String?
  vehicle           Vehicle?   @relation(fields: [vehicleId], references: [id])
  
  // Locations
  pickupAddress     String
  pickupLat         Float
  pickupLng         Float
  dropoffAddress    String
  dropoffLat        Float
  dropoffLng        Float
  
  // Fare calculation
  zone              FareZone
  distanceKm        Float?     // For Zone 2 only
  baseFare          Float      // Before multipliers
  fareMultiplier    Float      @default(1.0)
  surgePct          Float      @default(0)
  totalFare         Float      // Final ZAR amount
  driverPayout      Float      // 80% of totalFare
  projoCommission   Float      // 20% of totalFare
  
  // Status
  status            RideStatus @default(REQUESTED)
  
  // Scheduled rides
  isScheduled       Boolean    @default(false)
  scheduledFor      DateTime?
  
  // Tracking
  driverArrivedAt   DateTime?
  rideStartedAt     DateTime?
  rideCompletedAt   DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  
  // Share link
  shareToken        String?    @unique @default(cuid())
  
  // Payment
  paidWithWallet    Boolean    @default(false)
  paymentRef        String?
  
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  
  rating            Rating?

  @@map("rides")
}

// ─── DELIVERIES ──────────────────────────────────────────────

model Delivery {
  id                String         @id @default(uuid())
  trackingNumber    String         @unique @default(cuid())
  
  senderId          String
  driverId          String?
  driver            Driver?        @relation(fields: [driverId], references: [id])
  
  // Package info
  description       String
  weight            Float?         // kg
  isFragile         Boolean        @default(false)
  
  // Addresses
  pickupAddress     String
  pickupLat         Float
  pickupLng         Float
  recipientName     String
  recipientPhone    String
  dropoffAddress    String
  dropoffLat        Float
  dropoffLng        Float
  
  // Fare
  distanceKm        Float
  fare              Float          // ZAR
  
  status            DeliveryStatus @default(PENDING)
  
  estimatedDelivery DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("deliveries")
}

// ─── PRODUCTS ────────────────────────────────────────────────

model Product {
  id              String    @id @default(uuid())
  name            String
  description     String?
  category        String
  priceZar        Float     // Price in ZAR
  stockQty        Int       @default(0)
  imageUrl        String?
  isActive        Boolean   @default(true)
  weight          Float?    // kg — for delivery calculation
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  orderItems      OrderItem[]

  @@map("products")
}

// ─── ORDERS ──────────────────────────────────────────────────

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  
  items           OrderItem[]
  subtotal        Float       // ZAR
  deliveryFee     Float       @default(0)
  total           Float       // ZAR
  
  status          OrderStatus @default(PENDING)
  
  // Delivery address (within Rustenburg only)
  deliveryAddress String
  deliveryLat     Float?
  deliveryLng     Float?
  
  paidWithWallet  Boolean     @default(false)
  paymentRef      String?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  priceZar    Float    // Price at time of purchase
  
  @@map("order_items")
}

// ─── WALLET ──────────────────────────────────────────────────

model Wallet {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id])
  
  balanceZar      Float         @default(0)
  loyaltyPoints   Int           @default(0)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  transactions    Transaction[]

  @@map("wallets")
}

model Transaction {
  id              String            @id @default(uuid())
  walletId        String
  wallet          Wallet            @relation(fields: [walletId], references: [id])
  
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  amountZar       Float
  description     String
  referenceId     String?           // ride/order/delivery ID
  paymentRef      String?           // PayFast ref
  
  createdAt       DateTime          @default(now())

  @@map("transactions")
}

// ─── RATINGS ─────────────────────────────────────────────────

model Rating {
  id            String   @id @default(uuid())
  rideId        String   @unique
  ride          Ride     @relation(fields: [rideId], references: [id])
  
  raterId       String   // who gave the rating
  rater         User     @relation("RatingsGiven", fields: [raterId], references: [id])
  rateeId       String   // who received the rating
  ratee         User     @relation("RatingsReceived", fields: [rateeId], references: [id])
  
  stars         Int      // 1-5
  comment       String?
  
  createdAt     DateTime @default(now())

  @@map("ratings")
}

// ─── PROMO CODES ─────────────────────────────────────────────

model PromoCode {
  id              String    @id @default(uuid())
  code            String    @unique
  description     String?
  discountZar     Float?
  discountPct     Float?
  maxUses         Int       @default(1)
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  
  createdAt       DateTime  @default(now())

  @@map("promo_codes")
}

// ─── SURGE ZONES ─────────────────────────────────────────────

model SurgeZone {
  id              String   @id @default(uuid())
  name            String   // e.g. "Rustenburg CBD", "Boitekong"
  multiplier      Float    @default(1.0)
  isActive        Boolean  @default(false)
  
  // Bounding box (simplified)
  swLat           Float
  swLng           Float
  neLat           Float
  neLng           Float
  
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("surge_zones")
}

// ─── NOTIFICATIONS ───────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  title     String
  body      String
  type      String   // ride_update, delivery_update, promo, etc.
  isRead    Boolean  @default(false)
  data      Json?    // extra payload
  
  createdAt DateTime @default(now())

  @@map("notifications")
}
