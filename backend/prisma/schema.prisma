generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  phone        String    @unique
  pushSubscription String?
  name         String
  role         String    @default("PASSENGER")
  status       String    @default("PENDING_VERIFICATION")
  avatarUrl    String?
  passwordHash String?
  otpCode      String?
  otpExpiresAt DateTime?
  lastLoginAt  DateTime?
  fcmToken     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  wallet       Wallet?
  notifications Notification[]
  localAds      LocalAd[]
  classifieds   Classified[]
  datingProfile  DatingProfile?
  communityIdentity CommunityIdentity?
  panicContacts  PanicContact[]
  panicAlerts    PanicAlert[]
  @@map("users")
}
model Wallet {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id])
  balanceZar    Float         @default(0)
  loyaltyPoints Int           @default(0)
  lifetimeSpend Float         @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
  @@map("wallets")
}
model Transaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  type        String
  status      String   @default("PENDING")
  amountZar   Float
  description String
  referenceId String?
  paymentRef  String?
  createdAt   DateTime @default(now())
  @@map("transactions")
}
model Ride {
  id             String    @id @default(uuid())
  passengerId    String
  driverId       String?
  pickupAddress  String
  pickupLat      Float
  pickupLng      Float
  dropoffAddress String
  dropoffLat     Float
  dropoffLng     Float
  zone           String    @default("ZONE_1_FLAT")
  distanceKm     Float?
  baseFare       Float     @default(0)
  totalFare      Float     @default(60)
  driverPayout   Float     @default(48)
  status         String    @default("REQUESTED")
  isScheduled    Boolean   @default(false)
  scheduledFor   DateTime?
  shareToken     String?   @unique @default(cuid())
  paidWithWallet Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@map("rides")
}
model Delivery {
  id             String   @id @default(uuid())
  trackingNumber String   @unique @default(cuid())
  senderId       String
  driverId       String?
  description    String   @default("Package")
  pickupAddress  String
  pickupLat      Float    @default(0)
  pickupLng      Float    @default(0)
  recipientName  String
  recipientPhone String
  dropoffAddress String
  dropoffLat     Float    @default(0)
  dropoffLng     Float    @default(0)
  distanceKm     Float    @default(0)
  fare           Float    @default(60)
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@map("deliveries")
}
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String   @default("general")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  @@map("notifications")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String
  priceZar    Float    @default(0)
  stockQty    Int      @default(999)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("products")
}

model PromoCode {
  id              String   @id @default(uuid())
  code            String   @unique
  description     String?
  discountType    String
  discountValue   Float
  minOrderAmount  Float?
  maxDiscount     Float?
  maxUses         Int?
  usedCount       Int      @default(0)
  oneTimePerUser  Boolean  @default(true)
  isActive        Boolean  @default(true)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  usages          PromoUsage[]
}

model PromoUsage {
  id           String    @id @default(uuid())
  promoCodeId  String
  promoCode    PromoCode @relation(fields: [promoCodeId], references: [id])
  userId       String
  usedAt       DateTime  @default(now())

  @@unique([promoCodeId, userId])
}

model ProductOptionGroup {
  id          String                @id @default(uuid())
  productId   String
  name        String
  type        String                @default("SINGLE")
  required    Boolean               @default(false)
  sortOrder   Int                   @default(0)
  choices     ProductOptionChoice[]
  createdAt   DateTime              @default(now())
}

model ProductOptionChoice {
  id            String              @id @default(uuid())
  groupId       String
  group         ProductOptionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label         String
  priceModifier Float               @default(0)
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
}

model ServiceOrder {
  id              String    @id @default(uuid())
  userId          String
  productId       String
  productName     String
  category        String
  basePrice       Float
  finalPrice      Float
  loyaltyDiscount Float     @default(0)
  loyaltyTier     String?
  paidWithWallet  Boolean   @default(false)
  status          String    @default("CONFIRMED")
  scheduledFor    DateTime?
  address         String
  phone           String
  notes           String?
  selectedOptions String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model LocalAd {
  id            String   @id @default(uuid())
  businessName  String
  category      String   @default("Other")
  offer         String
  description   String   @default("")
  phone         String   @default("")
  website       String   @default("")
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("local_ads")
}

model Classified {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String   @default("General")
  price       String   @default("")
  location    String   @default("")
  phone       String   @default("")
  mediaData   String?  @db.Text
  mediaType   String   @default("")
  status      String   @default("ACTIVE") // ACTIVE, SOLD, EXPIRED
  expiresAt   DateTime @default(dbgenerated("NOW() + INTERVAL '2 months'"))
  renewedAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("classifieds")
}

// ── PROJO DATING MODELS ──────────────────────────────────────

model DatingProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  
  // Basic info
  displayName       String
  age               Int
  gender            String
  interestedIn      String[] // ["Men","Women","Everyone"]
  relationshipGoals String[] // ["Serious","Marriage","Casual","Friendship" etc]
  bio               String   @default("") @db.Text
  occupation        String   @default("")
  education         String   @default("")
  
  // Location
  city              String   @default("Rustenburg")
  suburb            String   @default("")
  showExactLocation Boolean  @default(false)
  latitude          Float?
  longitude         Float?
  
  // Lifestyle
  height            Int?     // cm
  bodyType          String   @default("")
  ethnicity         String   @default("")
  religion          String   @default("")
  languages         String[] @default(["English"])
  smoking           String   @default("Non-smoker")
  drinking          String   @default("Social drinker")
  children          String   @default("No children")
  pets              String   @default("")
  
  // Interests & personality
  interests         String[]
  music             String[]
  movies            String[]
  
  // Photos & media
  photos            String[] // URLs
  introVideo        String?
  
  // Status & premium
  isVerified        Boolean  @default(false)
  isPremium         Boolean  @default(false)
  isPromoFree       Boolean  @default(false) // true if Premium was granted via the first-150-free promo (no payment owed)
  premiumExpiry     DateTime?
  isOnline          Boolean  @default(false)
  lastActive        DateTime @default(now())
  profileComplete   Int      @default(0) // percentage
  isActive          Boolean  @default(true)
  isIncognito       Boolean  @default(false)
  isDemo            Boolean  @default(false) // seeded placeholder profile — auto-hidden once enough real profiles exist
  hasSeenOnboardingTour Boolean @default(false)
  
  // Stats
  likesReceived     Int      @default(0)
  matchCount        Int      @default(0)
  profileViews      Int      @default(0)
  boostActive       Boolean  @default(false)
  boostExpiry       DateTime?
  isFeatured        Boolean  @default(false)
  featuredExpiry    DateTime?
  
  // Relations
  sentLikes         DatingLike[]    @relation("SentLikes")
  receivedLikes     DatingLike[]    @relation("ReceivedLikes")
  matches1          DatingMatch[]   @relation("Match1")
  matches2          DatingMatch[]   @relation("Match2")
  sentMessages      DatingMessage[] @relation("SentMessages")
  receivedMessages  DatingMessage[] @relation("ReceivedMessages")
  blockedUsers      DatingBlock[]   @relation("BlockedBy")
  blockedByUsers    DatingBlock[]   @relation("BlockedUser")
  reports           DatingReport[]  @relation("ReportedBy")
  sentPasses        DatingPass[]    @relation("SentPasses")
  receivedPasses    DatingPass[]    @relation("ReceivedPasses")
  verificationRequests DatingVerificationRequest[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@map("dating_profiles")
}

model DatingLike {
  id          String   @id @default(uuid())
  fromId      String
  toId        String
  from        DatingProfile @relation("SentLikes", fields: [fromId], references: [id])
  to          DatingProfile @relation("ReceivedLikes", fields: [toId], references: [id])
  isSuperLike Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@unique([fromId, toId])
  @@map("dating_likes")
}

model DatingMatch {
  id          String   @id @default(uuid())
  profile1Id  String
  profile2Id  String
  profile1    DatingProfile @relation("Match1", fields: [profile1Id], references: [id])
  profile2    DatingProfile @relation("Match2", fields: [profile2Id], references: [id])
  compatScore Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  messages    DatingMessage[]
  @@unique([profile1Id, profile2Id])
  @@map("dating_matches")
}

model DatingMessage {
  id          String   @id @default(uuid())
  matchId     String
  match       DatingMatch @relation(fields: [matchId], references: [id])
  fromId      String
  toId        String
  from        DatingProfile @relation("SentMessages", fields: [fromId], references: [id])
  to          DatingProfile @relation("ReceivedMessages", fields: [toId], references: [id])
  content     String   @db.Text
  type        String   @default("text") // text, image, voice, video, gif
  mediaUrl    String?
  isRead      Boolean  @default(false)
  readAt      DateTime?
  reaction    String?
  createdAt   DateTime @default(now())
  @@map("dating_messages")
}

model DatingBlock {
  id          String   @id @default(uuid())
  blockerId   String
  blockedId   String
  blocker     DatingProfile @relation("BlockedBy", fields: [blockerId], references: [id])
  blocked     DatingProfile @relation("BlockedUser", fields: [blockedId], references: [id])
  createdAt   DateTime @default(now())
  @@unique([blockerId, blockedId])
  @@map("dating_blocks")
}

model DatingPass {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  from      DatingProfile @relation("SentPasses", fields: [fromId], references: [id])
  to        DatingProfile @relation("ReceivedPasses", fields: [toId], references: [id])
  createdAt DateTime @default(now())
  @@unique([fromId, toId])
  @@map("dating_passes")
}

model DatingVerificationRequest {
  id         String   @id @default(uuid())
  profileId  String
  profile    DatingProfile @relation(fields: [profileId], references: [id])
  selfieUrl  String   @db.Text
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy String?
  reviewNote String   @default("")
  createdAt  DateTime @default(now())
  reviewedAt DateTime?
  @@map("dating_verification_requests")
}

model DatingReport {
  id          String   @id @default(uuid())
  reporterId  String
  reportedId  String
  reporter    DatingProfile @relation("ReportedBy", fields: [reporterId], references: [id])
  reason      String
  details     String   @default("")
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  @@map("dating_reports")
}

// ══════════════════════════════════════════════════════════════
// COMMUNITY CHAT ROOMS — anonymous, engagement-only, separate from Dating
// ══════════════════════════════════════════════════════════════

model CommunityIdentity {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  displayName String   @unique   // e.g. "BlueFox247" — never the user's dating name
  avatarKey   String              // key into the built-in avatar library (no photos)
  createdAt   DateTime @default(now())
  @@map("community_identities")
}

model ChatRoom {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String   @default("")
  category     String   @default("General") // General, Relationships, Advice, Fun, Local, Support
  icon         String   @default("💬")
  mode         String   @default("ANONYMOUS") // ANONYMOUS = Dating Lounge (masked identity, contact-info blocked)
                                                // OPEN_LOCAL = PROJO Community (real identity, contact info & photos allowed)
  isActive     Boolean  @default(true)
  isPinnedTop  Boolean  @default(false)
  messageCount Int      @default(0)
  memberCount  Int      @default(0)
  lastActivityAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  messages     ChatMessage[]
  members      ChatRoomMember[]
  polls        ChatPoll[]
  @@map("chat_rooms")
}

model ChatRoomMember {
  id         String   @id @default(uuid())
  roomId     String
  room       ChatRoom @relation(fields: [roomId], references: [id])
  userId     String
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())
  @@unique([roomId, userId])
  @@map("chat_room_members")
}

model ChatMessage {
  id          String   @id @default(uuid())
  roomId      String
  room        ChatRoom @relation(fields: [roomId], references: [id])
  userId      String              // real user id — never exposed for ANONYMOUS rooms; kept for OPEN_LOCAL rooms
  identityId  String?             // anon identity id (ANONYMOUS rooms only)
  displayName String              // anon alias (ANONYMOUS) or real name snapshot (OPEN_LOCAL)
  avatarKey   String?             // built-in avatar key (ANONYMOUS rooms only)
  avatarUrl   String?             // real profile photo snapshot (OPEN_LOCAL rooms only)
  type        String   @default("text") // text, emoji, gif, image, voice, poll, announcement
  content     String   @default("") @db.Text
  mediaUrl    String?  @db.Text
  pollId      String?
  status      String   @default("VISIBLE") // VISIBLE, HELD_FOR_REVIEW, REMOVED
  isFlagged   Boolean  @default(false)
  flagReason  String?
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  reactions   ChatReaction[]
  reports     ChatReport[]
  @@index([roomId, createdAt])
  @@map("chat_messages")
}

model ChatReaction {
  id        String   @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id])
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  @@unique([messageId, userId])
  @@map("chat_reactions")
}

model ChatPoll {
  id        String   @id @default(uuid())
  roomId    String
  room      ChatRoom @relation(fields: [roomId], references: [id])
  question  String
  options   String[]
  createdBy String
  closesAt  DateTime?
  createdAt DateTime @default(now())
  votes     ChatPollVote[]
  @@map("chat_polls")
}

model ChatPollVote {
  id          String   @id @default(uuid())
  pollId      String
  poll        ChatPoll @relation(fields: [pollId], references: [id])
  userId      String
  optionIndex Int
  createdAt   DateTime @default(now())
  @@unique([pollId, userId])
  @@map("chat_poll_votes")
}

model ChatReport {
  id         String   @id @default(uuid())
  reporterId String
  messageId  String?
  message    ChatMessage? @relation(fields: [messageId], references: [id])
  roomId     String?
  reason     String
  details    String   @default("")
  status     String   @default("PENDING") // PENDING, REVIEWED, DISMISSED, ACTIONED
  createdAt  DateTime @default(now())
  @@map("chat_reports")
}

// Full audit trail for every automated or manual moderation action
model ChatModerationEvent {
  id        String   @id @default(uuid())
  userId    String?
  roomId    String?
  messageId String?
  action    String   // BLOCKED_CONTACT_INFO, BLOCKED_PROFANITY, MASKED_PROFANITY, FLOOD_BLOCKED, MUTED, BANNED, UNBANNED, MESSAGE_REMOVED
  reason    String   @default("")
  detail    String   @default("") @db.Text
  createdAt DateTime @default(now())
  @@map("chat_moderation_events")
}

model ChatSanction {
  id        String    @id @default(uuid())
  userId    String
  roomId    String?             // null = applies to all rooms
  type      String              // MUTE, BAN
  reason    String   @default("")
  issuedBy  String?             // admin userId; null = automated system action
  expiresAt DateTime?           // null = permanent
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  @@index([userId, isActive])
  @@map("chat_sanctions")
}

// ══════════════════════════════════════════════════════════════
// PANIC / EMERGENCY ALERT SYSTEM
// ══════════════════════════════════════════════════════════════

model PanicContact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String   @default("") // e.g. "Mom", "Best friend"
  phone     String              // E.164 format, e.g. +27821234567
  callmebotApiKey String?        // optional — lets this contact receive free WhatsApp via CallMeBot
  createdAt DateTime @default(now())
  @@map("panic_contacts")
}

model SecurityMonitorContact {
  id          String   @id @default(uuid())
  companyName String
  phone       String              // E.164 format
  callmebotApiKey String?         // optional — lets this contact receive free WhatsApp via CallMeBot
  isActive    Boolean  @default(true)
  addedBy     String?             // admin userId
  createdAt   DateTime @default(now())
  @@map("security_monitor_contacts")
}

model PanicAlert {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  anonymousPhone String?             // optional, only if we somehow have a contact for a non-logged-in trigger
  latitude       Float?
  longitude      Float?
  status         String   @default("ACTIVE") // ACTIVE, ACKNOWLEDGED, RESOLVED, FALSE_ALARM
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  notes          String   @default("")
  dispatchLog    String   @default("") @db.Text // JSON summary of which channels/recipients were notified and outcomes
  createdAt      DateTime @default(now())
  @@index([status, createdAt])
  @@map("panic_alerts")
}
