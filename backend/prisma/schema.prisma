generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  phone        String    @unique
  pushSubscription String?
  name         String
  role         String    @default("PASSENGER")
  status       String    @default("PENDING_VERIFICATION")
  avatarUrl    String?
  passwordHash String?
  otpCode      String?
  otpExpiresAt DateTime?
  lastLoginAt  DateTime?
  fcmToken     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  wallet       Wallet?
  notifications Notification[]
  localAds      LocalAd[]
  classifieds   Classified[]
  @@map("users")
}
model Wallet {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id])
  balanceZar    Float         @default(0)
  loyaltyPoints Int           @default(0)
  lifetimeSpend Float         @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
  @@map("wallets")
}
model Transaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  type        String
  status      String   @default("PENDING")
  amountZar   Float
  description String
  referenceId String?
  paymentRef  String?
  createdAt   DateTime @default(now())
  @@map("transactions")
}
model Ride {
  id             String    @id @default(uuid())
  passengerId    String
  driverId       String?
  pickupAddress  String
  pickupLat      Float
  pickupLng      Float
  dropoffAddress String
  dropoffLat     Float
  dropoffLng     Float
  zone           String    @default("ZONE_1_FLAT")
  distanceKm     Float?
  baseFare       Float     @default(0)
  totalFare      Float     @default(60)
  driverPayout   Float     @default(48)
  status         String    @default("REQUESTED")
  isScheduled    Boolean   @default(false)
  scheduledFor   DateTime?
  shareToken     String?   @unique @default(cuid())
  paidWithWallet Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@map("rides")
}
model Delivery {
  id             String   @id @default(uuid())
  trackingNumber String   @unique @default(cuid())
  senderId       String
  driverId       String?
  description    String   @default("Package")
  pickupAddress  String
  pickupLat      Float    @default(0)
  pickupLng      Float    @default(0)
  recipientName  String
  recipientPhone String
  dropoffAddress String
  dropoffLat     Float    @default(0)
  dropoffLng     Float    @default(0)
  distanceKm     Float    @default(0)
  fare           Float    @default(60)
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@map("deliveries")
}
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String   @default("general")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  @@map("notifications")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String
  priceZar    Float    @default(0)
  stockQty    Int      @default(999)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("products")
}

model PromoCode {
  id              String   @id @default(uuid())
  code            String   @unique
  description     String?
  discountType    String
  discountValue   Float
  minOrderAmount  Float?
  maxDiscount     Float?
  maxUses         Int?
  usedCount       Int      @default(0)
  oneTimePerUser  Boolean  @default(true)
  isActive        Boolean  @default(true)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  usages          PromoUsage[]
}

model PromoUsage {
  id           String    @id @default(uuid())
  promoCodeId  String
  promoCode    PromoCode @relation(fields: [promoCodeId], references: [id])
  userId       String
  usedAt       DateTime  @default(now())

  @@unique([promoCodeId, userId])
}

model ProductOptionGroup {
  id          String                @id @default(uuid())
  productId   String
  name        String
  type        String                @default("SINGLE")
  required    Boolean               @default(false)
  sortOrder   Int                   @default(0)
  choices     ProductOptionChoice[]
  createdAt   DateTime              @default(now())
}

model ProductOptionChoice {
  id            String              @id @default(uuid())
  groupId       String
  group         ProductOptionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label         String
  priceModifier Float               @default(0)
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
}

model ServiceOrder {
  id              String    @id @default(uuid())
  userId          String
  productId       String
  productName     String
  category        String
  basePrice       Float
  finalPrice      Float
  loyaltyDiscount Float     @default(0)
  loyaltyTier     String?
  paidWithWallet  Boolean   @default(false)
  status          String    @default("CONFIRMED")
  scheduledFor    DateTime?
  address         String
  phone           String
  notes           String?
  selectedOptions String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model LocalAd {
  id            String   @id @default(uuid())
  businessName  String
  category      String   @default("Other")
  offer         String
  description   String   @default("")
  phone         String   @default("")
  website       String   @default("")
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("local_ads")
}

model Classified {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String   @default("General")
  price       String   @default("")
  location    String   @default("")
  phone       String   @default("")
  mediaData   String?  @db.Text
  mediaType   String   @default("")
  status      String   @default("ACTIVE") // ACTIVE, SOLD, EXPIRED
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("classifieds")
}
