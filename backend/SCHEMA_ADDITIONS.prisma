// ============================================================
// PROJO GROUP — Add these models to your backend/prisma/schema.prisma
// Then run: npx prisma migrate dev --name add_promo_and_push
// ============================================================

// Add this field to your existing User model:
//   pushSubscription String?  // JSON string of push subscription

model PromoCode {
  id              String   @id @default(uuid())
  code            String   @unique
  description     String?
  discountType    String   // "PERCENTAGE" or "FIXED"
  discountValue   Float
  minOrderAmount  Float?
  maxDiscount     Float?
  maxUses         Int?
  usedCount       Int      @default(0)
  oneTimePerUser  Boolean  @default(true)
  isActive        Boolean  @default(true)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  usages          PromoUsage[]
}

model PromoUsage {
  id           String    @id @default(uuid())
  promoCodeId  String
  promoCode    PromoCode @relation(fields: [promoCodeId], references: [id])
  userId       String
  usedAt       DateTime  @default(now())

  @@unique([promoCodeId, userId])
}
